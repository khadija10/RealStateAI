# Copier ce fichier en .env, puis y coller la vraie clé.
# Le .env ne doit JAMAIS être commité : il est déjà couvert par le .gitignore.
#
# Clé xAI : https://console.x.ai/ -> API Keys
XAI_API_KEY=colle_ta_cle_ici

# API compatible OpenAI : changer ces deux lignes suffit pour passer
# à Groq, Mistral ou OpenRouter, sans toucher au code.
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.6
