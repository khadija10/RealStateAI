# Données brutes DVF — 1.9 Go, inutiles dans l'image
Backend/Data pipeline/Data/
Backend/Data pipeline/outputs/
# Exclure tout data/ sauf le gold parquet et les samples
data/raw/
data/interim/
data/external/*
# … sauf la BDNB agrégée par parcelle (27 Mo), lue à l'inférence par ml/contexte.py
!data/external/bdnb
data/external/bdnb/*
!data/external/bdnb/bdnb_parcelle.parquet
data/dvf_raw*/
data-pipeline/

# Environnements Python virtuels
data_env/
data-pipeline/.venv/
.venv/

# Dépendances JS
Frontend/node_modules/
Frontend/dist/

# Git
.git/
.gitignore
.gitattributes

# Cache Python
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Fichiers de dev
*.log
.env*
.DS_Store
