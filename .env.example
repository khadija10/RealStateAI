# Copier en .env et remplir les valeurs avant docker compose up

# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# URL du backend vue par le navigateur (défaut : localhost:8000)
# Sur un serveur : http://VOTRE_IP:8000 ou https://api.votre-domaine.com
VITE_API_URL=http://localhost:8000

# --- PostgreSQL (uniquement avec docker-compose.postgres.yml) ---
DB_PASSWORD=devpass
